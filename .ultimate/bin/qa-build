#!/usr/bin/env bash
# Usage: qa-build <cart|all> [debug|release|harness]; qa-build count
set -euo pipefail

usage() {
  echo 'Usage: qa-build <cart|all> [debug|release|harness]; qa-build count' >&2
  exit 1
}
[[ $# -ge 1 && $# -le 2 ]] || usage
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
export PATH="$HOME/.local/share/quantattack-tools/venv/bin:$PATH"
mapfile -t carts < data/cartridges.txt
version=$(<data/version.txt)
request=$1
config=${2:-debug}
count=false
if [[ "$request" == count ]]; then
  [[ $# == 1 ]] || usage
  config=release
  count=true
  request=all
fi
case "$config" in
  debug|release|harness) ;;
  *) usage ;;
esac
if [[ "$request" != all ]]; then
  valid=false
  for cart in "${carts[@]}"; do
    [[ "$request" != "$cart" ]] || valid=true
  done
  "$valid" || usage
  carts=("$request")
fi
for tool in p8tool shrinko8; do
  command -v "$tool" >/dev/null || { echo 'Run .ultimate/bin/qa-setup first.' >&2; exit 1; }
done
output="build/v${version}_${config}"
install_dir="$HOME/.lexaloffle/pico-8/carts/quantattack/v${version}_${config}"
src="$PWD/src"
if [[ "$config" == harness ]]; then
  # Release code wrapped by .ultimate/harness (see qa-run), built from a staged copy of src/.
  # Not installed: qa-run copies build/v<version>_harness into a throwaway PICO-8 home.
  src="$PWD/build/harness_src"
  rsync -a --delete src/ "$src/"
fi
for cart in "${carts[@]}"; do
  symbols=$cart
  [[ "$config" != debug ]] || symbols="tostring,dump,$symbols"
  case "$cart" in endless|rush) symbols+=,sash ;; esac
  main="main_${cart}.lua"
  if [[ "$config" == harness ]]; then
    main="qa_main_${cart}.lua"
    # Concatenated, not required: picotool fails to wrap a main file as a module.
    cat .ultimate/harness/qa_pre.lua "src/main_${cart}.lua" .ultimate/harness/qa_post.lua > "$src/$main"
  fi
  # Match Rakefile's build_cartridge_command, including metadata and minification.
  ./pico-boots/scripts/build_cartridge.sh "$src" "$main" \
    -d "$PWD/data/builtin_data_${cart}.p8" -M "$PWD/data/metadata.p8" \
    -a yasuhito -t "quantattack v${version} (${cart})" \
    -p "$PWD/$output" -o "quantattack_${cart}" -s "$symbols" --minify-level 1
  if [[ "$config" != harness ]]; then
    mkdir -p "$install_dir"
    cp "$output/quantattack_${cart}.p8" "$install_dir/"
  fi
  if "$count"; then
    stats=$(shrinko8 "$output/quantattack_${cart}.p8" --parsable-count --count)
    if [[ "$stats" =~ count:None:tokens:([0-9]+) ]]; then
      printf '%s: %s tokens\n' "$cart" "${BASH_REMATCH[1]}"
    else
      echo "Invalid shrinko8 output for $cart: $stats" >&2
      exit 1
    fi
  fi
done
